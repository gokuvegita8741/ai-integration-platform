generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  createdAt DateTime @default(now())

  chatbot          UserChatbot?
  chats            Chat[]
  workspaces       Workspace[]
  workspaceMembers WorkspaceMember[]
  documents        Document[]
  agents           Agent[]
  activities       ActivityLog[]
}

model UserChatbot {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  chats     Chat[]
}

model Chat {
  id            String   @id @default(uuid())
  userId        String
  chatbotId     String
  name          String   @default("New Chat")

  source        ChatSource
  websiteDomain String?
  pagePath      String?
  projectName   String?

  workspaceId   String?
  isPinned      Boolean  @default(false)
  isArchived    Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user          User         @relation(fields: [userId], references: [id])
  chatbot       UserChatbot  @relation(fields: [chatbotId], references: [id])
  workspace     Workspace?   @relation(fields: [workspaceId], references: [id])
  messages      ChatMessage[]

  @@index([workspaceId])
}

model ChatMessage {
  id              String               @id @default(uuid())
  chatId          String
  sender          MessageSender
  message         String               // Legacy fallback, new messages use versions
  sequence        Int                  // 0,1,2,3… – stable position in chat
  isActive        Boolean              @default(true)
  activeVersionId String?              @unique
  parentVersionId String?
  createdAt       DateTime             @default(now())

  chat            Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  versions        ChatMessageVersion[]
  activeVersion   ChatMessageVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id])
  parentVersion   ChatMessageVersion?  @relation("BranchParent", fields: [parentVersionId], references: [id])

  @@index([chatId, sequence])
  @@index([chatId, isActive])
  @@index([parentVersionId])
}

model ChatMessageVersion {
  id            String       @id @default(uuid())
  messageId     String
  versionNumber Int          // 1 = original, 2 = first regen, ...
  content       String
  createdAt     DateTime     @default(now())
  model         String?      // e.g. "gemma-3-27b-it"
  temperature   Float?

  message       ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  activeFor     ChatMessage? @relation("ActiveVersion")
  branchMessages ChatMessage[] @relation("BranchParent")

  @@unique([messageId, versionNumber])
  @@index([messageId])
}

model Workspace {
  id             String          @id @default(uuid())
  name           String
  description    String?
  icon           String?         // Lucide icon name or emoji
  color          String?         // Hex color code
  status         WorkspaceStatus @default(active)
  userId         String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  lastActivityAt DateTime        @default(now())

  user           User            @relation(fields: [userId], references: [id])
  members        WorkspaceMember[]
  chats          Chat[]
  documents      Document[]
  agents         Agent[]
  activities     ActivityLog[]

  @@index([userId])
  @@index([userId, status])
}

model WorkspaceMember {
  id          String   @id @default(uuid())
  userId      String
  workspaceId String
  role        String   @default("owner") // owner, editor, viewer
  joinedAt    DateTime @default(now())

  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Document {
  id               String                   @id @default(uuid())
  name             String
  originalName     String
  mimeType         String
  sizeBytes        Int
  filePath         String
  workspaceId      String
  userId           String
  processingStatus DocumentProcessingStatus @default(pending)
  chunkStatus      String?                  // Future RAG
  embeddingStatus  String?                  // Future RAG
  vectorStatus     String?                  // Future RAG
  knowledgeStatus  String?                  // Future RAG
  metadata         Json?                    // Flexible metadata
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user             User      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
}

model Agent {
  id          String    @id @default(uuid())
  name        String
  description String?
  type        AgentType @default(custom)
  config      Json?     // Flexible agent configuration
  enabled     Boolean   @default(false)
  workspaceId String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
}

model ActivityLog {
  id          String         @id @default(uuid())
  action      ActivityAction
  entityType  String         // "workspace", "chat", "document", "agent"
  entityId    String?
  entityName  String?        // Human-readable name of the entity
  metadata    Json?          // Additional context
  workspaceId String?
  userId      String
  createdAt   DateTime       @default(now())

  workspace   Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user        User           @relation(fields: [userId], references: [id])

  @@index([workspaceId])
  @@index([userId])
  @@index([createdAt])
  @@index([workspaceId, createdAt, id])
  @@index([userId, createdAt, id])
}

enum ChatSource {
  standalone
  iframe
}

enum MessageSender {
  user
  assistant
}

enum WorkspaceStatus {
  active
  archived
  deleted
}

enum DocumentProcessingStatus {
  pending
  processing
  completed
  failed
}

enum AgentType {
  research
  coding
  writing
  data
  custom
}

enum ActivityAction {
  workspace_created
  workspace_updated
  chat_created
  chat_deleted
  document_uploaded
  document_deleted
  agent_created
  agent_updated
  agent_deleted
  settings_updated
}
