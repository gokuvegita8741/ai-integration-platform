generator client {
  provider = "prisma-client-py"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  createdAt DateTime @default(now())

  chatbot   UserChatbot?
  chats     Chat[]
}

model UserChatbot {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  chats     Chat[]
}

model Chat {
  id            String   @id @default(uuid())
  userId        String
  chatbotId     String
  name          String   @default("New Chat")

  source        ChatSource
  websiteDomain String?
  pagePath      String?
  projectName   String?

  createdAt     DateTime @default(now())

  user          User         @relation(fields: [userId], references: [id])
  chatbot       UserChatbot  @relation(fields: [chatbotId], references: [id])
  messages      ChatMessage[]
}

model ChatMessage {
  id              String               @id @default(uuid())
  chatId          String
  sender          MessageSender
  message         String               // Legacy fallback, new messages use versions
  sequence        Int                  // 0,1,2,3… – stable position in chat
  isActive        Boolean              @default(true)
  activeVersionId String?              @unique
  createdAt       DateTime             @default(now())

  chat            Chat                 @relation(fields: [chatId], references: [id], onDelete: Cascade)
  versions        ChatMessageVersion[]
  activeVersion   ChatMessageVersion?  @relation("ActiveVersion", fields: [activeVersionId], references: [id])

  @@index([chatId, sequence])
  @@index([chatId, isActive])
}

model ChatMessageVersion {
  id            String       @id @default(uuid())
  messageId     String
  versionNumber Int          // 1 = original, 2 = first regen, ...
  content       String
  createdAt     DateTime     @default(now())
  model         String?      // e.g. "gemma-3-27b-it"
  temperature   Float?

  message       ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  activeFor     ChatMessage? @relation("ActiveVersion")

  @@unique([messageId, versionNumber])
  @@index([messageId])
}

enum ChatSource {
  standalone
  iframe
}

enum MessageSender {
  user
  assistant
}
